{
  "name": "@saveboard/extension",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox --mv3",
    "build": "wxt build",
    "build:firefox": "wxt build -b firefox --mv3",
    "zip": "wxt zip",
    "zip:all": "wxt zip && wxt zip -b edge && wxt zip -b firefox --mv3",
    "postinstall": "wxt prepare",
    "typecheck": "tsc --noEmit",
    "test": "echo 'extension unit tests live in packages/core; run pnpm e2e for browser tests'",
    "e2e": "wxt build && playwright test",
    "screenshots": "wxt build && SCREENSHOTS=1 playwright test e2e/screenshots.spec.ts",
    "icons": "node scripts/render-icons.mjs"
  },
  "dependencies": {
    "@saveboard/core": "workspace:*",
    "@tanstack/react-virtual": "^3.13.12",
    "dexie": "^4.0.11",
    "dexie-react-hooks": "^1.1.7",
    "lucide-react": "^0.544.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "@tailwindcss/vite": "^4.1.13",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "@wxt-dev/module-react": "^1.1.3",
    "fflate": "^0.8.3",
    "tailwindcss": "^4.1.13",
    "typescript": "^5.8.3",
    "wxt": "^0.20.11"
  }
}
